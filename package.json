{
  "name": "exquisite-corpse",
  "version": "0.1.0",
  "private": true,
  "description": "Fold-and-draw chimera game. Static site: pictures travel inside the link, or are saved in players' own AT Protocol accounts.",
  "homepage": "https://sonatsuer.github.io/exquisite-corpse/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sonatsuer/exquisite-corpse.git"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "npm run typecheck && rm -rf docs/js && esbuild src/main.ts --bundle --format=esm --splitting --target=es2022 --outdir=docs/js --entry-names=[name] --chunk-names=chunks/[name]-[hash] --legal-comments=none --minify",
    "watch": "esbuild src/main.ts --bundle --format=esm --splitting --target=es2022 --outdir=docs/js --entry-names=[name] --chunk-names=chunks/[name]-[hash] --legal-comments=none --watch",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js",
    "check": "npm run build && npm test",
    "bench": "tsc -p tsconfig.test.json && node .test-build/scripts/bench.js",
    "golden": "tsc -p tsconfig.test.json && node .test-build/scripts/make-golden.js",
    "serve": "python3 -m http.server -d docs -b 127.0.0.1 8000"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@atproto/oauth-client-browser": "^0.5.18"
  }
}
